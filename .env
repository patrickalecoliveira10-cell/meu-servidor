env
# --- CONFIGURAÇÕES GERAIS ---
NODE_ENV=production
PORT=10000
UNIFIED_MODE=true

# --- BANCO DE DADOS (NEON) ---
# Copie a URL completa do seu painel no Neon
DATABASE_URL="postgres://usuario:senha@seu-host.neon.tech/neondb?sslmode=require"

# --- BYBIT API (EXECUTOR) ---
# Suas chaves de API da Bybit
BYBIT_API_KEY="SUA_KEY_AQUI"
BYBIT_API_SECRET="SEU_SECRET_AQUI"
BYBIT_ENV=v5

# --- CONFIGURAÇÕES DO SCANNER ---
# Intervalo de scan em milissegundos (ex: 1 minuto)
SCANNER_INTERVAL=60000
# Limite de moedas para escanear simultaneamente
SCAN_BATCH_SIZE=10

# --- CONFIGURAÇÕES DO BRAIN (IA) ---
# Intervalo de reavaliação da gestão (15 segundos)
MANAGEMENT_INTERVAL=15000
