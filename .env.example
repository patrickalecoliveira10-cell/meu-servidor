# Servidor
PORT=3002
NODE_ENV=production

# Banco de Dados (Neon.tech)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Configurações da IA
AI_MODE=observation
MIN_EXAMPLES_FOR_OPERATION=1000
LEARNING_RATE=0.01
CONFIDENCE_THRESHOLD=0.7
MAX_OPERATIONS_PER_DAY=10

# Conexão com Scanner
SCANNER_API_URL=https://seu-scanner.onrender.com
SCANNER_POLL_INTERVAL=5000

# Logs
LOG_LEVEL=info
LOG_FILE=true
LOG_CONSOLE=true

# Segurança
CORS_ORIGIN=*
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
