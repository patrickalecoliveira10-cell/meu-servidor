# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_fiHBIp2dXrU1@ep-silent-king-as5ku59d-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server Configuration
PORT=3001
NODE_ENV=development

# Scanner Configuration
SCANNER_COINS_COUNT=100
SCANNER_UPDATE_INTERVAL=60000
SCANNER_TIMEFRAMES=1m,5m,15m,1h,4h,1D

# Indicators Configuration
INDICATORS_EMA=true
INDICATORS_VWAP=true
INDICATORS_RSI=true
INDICATORS_MACD=true
INDICATORS_ADX=true
INDICATORS_ATR=true
INDICATORS_BOLLINGER=true
INDICATORS_PSAR=true
INDICATORS_STOCHASTIC=true
INDICATORS_KAMA=true
INDICATORS_HEIKEN=false
INDICATORS_ICHIMOKU=false
INDICATORS_OBV=true
INDICATORS_SUPERTREND=true

# EMA Periods
EMA_PERIODS=9,21,50,200

# RSI Configuration
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# MACD Configuration
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# ADX Configuration
ADX_PERIOD=14

# ATR Configuration
ATR_PERIOD=14

# Bollinger Bands Configuration
BOLLINGER_PERIOD=20
BOLLINGER_STD_DEV=2

# Stochastic Configuration
STOCH_K_PERIOD=14
STOCH_D_PERIOD=3
STOCH_SMOOTH=3

# Bybit API Configuration
BYBIT_API_URL=https://api.bybit.com
BYBIT_TESTNET=false

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE=true
LOG_CONSOLE=true

# Debug Mode
DEBUG=false

# Score Configuration
SCORE_MIN=0
SCORE_MAX=100
SCORE_WEAK_THRESHOLD=30
SCORE_NEUTRAL_THRESHOLD=60
SCORE_GOOD_THRESHOLD=80
SCORE_EXCELLENT_THRESHOLD=100

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
